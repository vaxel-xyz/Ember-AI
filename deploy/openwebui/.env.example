BIND_ADDRESS=0.0.0.0
OPENWEBUI_PORT=3003
# Two OpenAI-compatible connections (ADR 0012) — one key per base URL, semicolon-separated:
#   1) Ember LiteLLM gateway  — virtual key from `bin/ember keys create open-webui`
#   2) Hermes agent gateway   — API_SERVER_KEY from the mini's ~/.hermes/.env
OPENAI_API_BASE_URLS=http://172.20.142.7:4000/v1;http://172.20.142.184:8642/v1
OPENAI_API_KEYS=CHANGE_ME;CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME         # openssl rand -hex 32
WEBUI_URL=https://chat.vaxel.xyz
ENABLE_SIGNUP=true                 # set false after the first admin account exists
AIOHTTP_CLIENT_TIMEOUT=1800        # agent turns on hermes-agent can run long (ADR 0012)
